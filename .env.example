# Arcane — Hint-Chain Coding Challenge Platform

PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://arcane:arcane_secret@localhost:5432/arcane_db

# Redis
REDIS_URL=redis://localhost:6379

# Code Execution — Piston public API (no config needed)
# If self-hosting Piston later, uncomment:
# PISTON_URL=http://localhost:2000

# JWT
JWT_SECRET=change-this-to-a-real-secret-in-production
JWT_EXPIRY=24h

# Rate limiting
SUBMIT_RATE_LIMIT_WINDOW_MS=3000
SUBMIT_RATE_LIMIT_MAX=1

# Stale judging recovery
STALE_JUDGING_TIMEOUT_S=60

# Pool exhaustion
ALLOW_REPEAT_PROBLEM_IN_TYPE=true
